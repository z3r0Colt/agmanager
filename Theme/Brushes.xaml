<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Solid brushes (keep compatibility names) -->
    <SolidColorBrush x:Key="BackgroundBrush"    Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"       Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush"           Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="AccentBrush"         Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush"    Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentDimBrush"      Color="{StaticResource AccentDimColor}"/>
    <SolidColorBrush x:Key="CyanBrush"           Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="PinkBrush"           Color="{StaticResource PinkColor}"/>
    <SolidColorBrush x:Key="GreenBrush"          Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="BorderBrush"         Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush"           Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="{StaticResource TextSecondaryColor}"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource CyanColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentButtonBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8a70ff" Offset="0"/>
        <GradientStop Color="#5a3aee" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BgGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BackgroundColor}" Offset="0"/>
        <GradientStop Color="{StaticResource BgAltColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardOverlayBrush" StartPoint="0,0.4" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#d8000000" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#45ffffff" Offset="0"/>
        <GradientStop Color="#0cffffff" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NavActivePillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3f7c5cff" Offset="0"/>
        <GradientStop Color="#1f22d3ee" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NavActiveIndicatorBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7c5cff" Offset="0"/>
        <GradientStop Color="#22d3ee" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroBannerOverlay" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000a0d14" Offset="0"/>
        <GradientStop Color="#f00a0d14" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
