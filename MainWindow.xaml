<Window x:Class="AgApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AgApp.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Davey Jones' Locker" Height="780" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStyle="None" ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- 1px frame around the whole window -->
    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Title bar ──────────────────────────────────── -->
            <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="◈" FontSize="15" VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7c5cff" Offset="0"/>
                                <GradientStop Color="#22d3ee" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="  Davey Jones' Locker" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Drag region -->
                <Border Grid.Column="1" Background="Transparent"/>

                <!-- Window controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}" Click="MinBtn_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="10" IsHitTestVisible="False"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="MaxBtn_Click">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="10" IsHitTestVisible="False"/>
                    </Button>
                    <Button Style="{StaticResource CloseTitleBtn}" Click="CloseBtn_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="10" IsHitTestVisible="False"/>
                    </Button>
                </StackPanel>

                <!-- Bottom separator -->
                <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1"
                        Background="{StaticResource BorderBrush}"/>
            </Grid>

            <!-- ── App body ──────────────────────────────────── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Ambient blobs (behind everything) -->
                        <Grid Grid.Row="0" Grid.RowSpan="3" ClipToBounds="True"
                              IsHitTestVisible="False" Panel.ZIndex="0">
                            <!-- Blob 1: top indigo -->
                            <Ellipse Width="280" Height="280" Opacity="0.13"
                                     HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Margin="-100,-80,0,0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#7c5cff" Offset="0"/>
                                        <GradientStop Color="#007c5cff" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="blob1tx"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="blob1tx"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="0" To="35" Duration="0:0:22">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="blob1tx"
                                                                 Storyboard.TargetProperty="Y"
                                                                 From="0" To="25" Duration="0:0:18">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <!-- Blob 2: bottom cyan -->
                            <Ellipse Width="240" Height="240" Opacity="0.10"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Margin="0,0,-70,-70">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#22d3ee" Offset="0"/>
                                        <GradientStop Color="#0022d3ee" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="blob2tx"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="blob2tx"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="0" To="-25" Duration="0:0:26">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="blob2tx"
                                                                 Storyboard.TargetProperty="Y"
                                                                 From="0" To="-35" Duration="0:0:20">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <!-- Blob 3: middle pink -->
                            <Ellipse Width="200" Height="200" Opacity="0.07"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#f43f8e" Offset="0"/>
                                        <GradientStop Color="#00f43f8e" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="blob3tx"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="blob3tx"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="-18" To="18" Duration="0:0:30">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="blob3tx"
                                                                 Storyboard.TargetProperty="Y"
                                                                 From="-12" To="12" Duration="0:0:24">
                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>

                        <!-- Brand block -->
                        <StackPanel Grid.Row="0" Margin="20,24,20,20" Panel.ZIndex="1">
                            <TextBlock Text="Davey Jones' Locker" FontSize="17" FontWeight="Bold">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#7c5cff" Offset="0"/>
                                        <GradientStop Color="#22d3ee" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="Pirate Game Manager" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10.5" Margin="0,3,0,0" FontWeight="Medium"/>
                        </StackPanel>
                        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Panel.ZIndex="1"
                                Background="{StaticResource BorderBrush}" Margin="16,0"/>

                        <!-- Nav items -->
                        <StackPanel Grid.Row="1" Margin="0,10,0,0" Panel.ZIndex="1">
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Browse">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                Binding="{Binding DataContext.CurrentPage,
                                                          RelativeSource={RelativeSource AncestorType=Window},
                                                          Converter={StaticResource PageActive},
                                                          ConverterParameter=Browse}">
                                                <Setter Property="Tag" Value="active"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE12B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="Browse" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Downloads">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                Binding="{Binding DataContext.CurrentPage,
                                                          RelativeSource={RelativeSource AncestorType=Window},
                                                          Converter={StaticResource PageActive},
                                                          ConverterParameter=Downloads}">
                                                <Setter Property="Tag" Value="active"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="Downloads" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Library">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                Binding="{Binding DataContext.CurrentPage,
                                                          RelativeSource={RelativeSource AncestorType=Window},
                                                          Converter={StaticResource PageActive},
                                                          ConverterParameter=Library}">
                                                <Setter Property="Tag" Value="active"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="Library" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Settings">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                Binding="{Binding DataContext.CurrentPage,
                                                          RelativeSource={RelativeSource AncestorType=Window},
                                                          Converter={StaticResource PageActive},
                                                          ConverterParameter=Settings}">
                                                <Setter Property="Tag" Value="active"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateCommand}" CommandParameter="Redist">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                Binding="{Binding DataContext.CurrentPage,
                                                          RelativeSource={RelativeSource AncestorType=Window},
                                                          Converter={StaticResource PageActive},
                                                          ConverterParameter=Redist}">
                                                <Setter Property="Tag" Value="active"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="Runtimes" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Version footer -->
                        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0" Padding="20,12" Panel.ZIndex="1">
                            <StackPanel>
                                <!-- Now Playing indicator -->
                                <Border Visibility="{Binding IsNowPlaying, Converter={StaticResource BoolToVisible}}"
                                        Background="#1a7c5cff" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding NowPlayingText}" Foreground="{StaticResource TextBrush}"
                                               FontSize="10" TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock Text="v1.0.0" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Page content -->
                <Grid x:Name="PageHost" Grid.Column="1">
                    <views:BrowsePage DataContext="{Binding Browse}"
                                      Visibility="{Binding DataContext.CurrentPage,
                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource PageVisible},
                                                   ConverterParameter=Browse}"/>
                    <views:DownloadsPage DataContext="{Binding Downloads}"
                                         Visibility="{Binding DataContext.CurrentPage,
                                                      RelativeSource={RelativeSource AncestorType=Window},
                                                      Converter={StaticResource PageVisible},
                                                      ConverterParameter=Downloads}"/>
                    <views:LibraryPage DataContext="{Binding Library}"
                                       Visibility="{Binding DataContext.CurrentPage,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource PageVisible},
                                                    ConverterParameter=Library}"/>
                    <views:SettingsPage DataContext="{Binding Settings}"
                                        Visibility="{Binding DataContext.CurrentPage,
                                                     RelativeSource={RelativeSource AncestorType=Window},
                                                     Converter={StaticResource PageVisible},
                                                     ConverterParameter=Settings}"/>
                    <views:RedistPage DataContext="{Binding Redist}"
                                      Visibility="{Binding DataContext.CurrentPage,
                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource PageVisible},
                                                   ConverterParameter=Redist}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
