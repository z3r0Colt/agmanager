<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:AgApp.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="AgApp.MainWindow" Title="Davey Jones' Locker" Icon="/DaveyJonesLocker;component/appico.ico" Height="820" Width="1280" MinHeight="650" MinWidth="1020" Background="{StaticResource BackgroundBrush}" FontFamily="Segoe UI Variable, Segoe UI" WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Background="{StaticResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Image Source="/DaveyJonesLocker;component/Assets/Brand/logo-mark.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="DAVEY JONES' LOCKER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Click="MinBtn_Click" AutomationProperties.Name="Minimize">
                        <TextBlock Text="" Style="{StaticResource Icon}" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="MaxBtn_Click" AutomationProperties.Name="Maximize">
                        <TextBlock Text="" Style="{StaticResource Icon}" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseTitleBtn}" Click="CloseBtn_Click" AutomationProperties.Name="Close">
                        <TextBlock Text="" Style="{StaticResource Icon}" FontSize="10"/>
                    </Button>
                </StackPanel>
                <Border Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Bottom"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="24,28,20,24">
                            <Image Source="/DaveyJonesLocker;component/Assets/Brand/logo-mark.png" Width="68" Height="68" HorizontalAlignment="Left" Margin="0,0,0,14" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Davey Jones' Locker logo"/>
                            <TextBlock Text="Davey Jones'" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Locker" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="YOUR GAMES. YOUR SPACE." FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="PLAY" Style="{StaticResource Caption}" Margin="24,8,0,10"/>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Library" AutomationProperties.Name="Library">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Library">
                                                    <Setter Property="Tag" Value="active"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/>
                                        <TextBlock Text="Library" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Downloads" AutomationProperties.Name="Downloads">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Downloads">
                                                    <Setter Property="Tag" Value="active"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/>
                                        <TextBlock Text="Downloads" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Browse" AutomationProperties.Name="Discover">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Browse">
                                                    <Setter Property="Tag" Value="active"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/>
                                        <TextBlock Text="Discover" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="MANAGE" Style="{StaticResource Caption}" Margin="24,30,0,10"/>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Redist" AutomationProperties.Name="Game essentials">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Redist">
                                                    <Setter Property="Tag" Value="active"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/>
                                        <TextBlock Text="Game essentials" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" AutomationProperties.Name="Settings">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                                                    <Setter Property="Tag" Value="active"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/>
                                        <TextBlock Text="Settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding NavigateCommand}" CommandParameter="About" AutomationProperties.Name="About">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="About">
                                                    <Setter Property="Tag" Value="active"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/>
                                        <TextBlock Text="About" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="20,16,20,20">
                            <Border Visibility="{Binding IsNowPlaying, Converter={StaticResource BoolToVisible}}" Background="{StaticResource AccentDimBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="NOW PLAYING" FontSize="9" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding NowPlayingText}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Separator Margin="0,0,0,14"/>
                            <TextBlock Text="Made for your next session." Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding About.AppVersion}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid x:Name="PageHost" Grid.Column="1">
                    <views:BrowsePage DataContext="{Binding Browse}" Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=Browse}"/>
                    <views:DownloadsPage DataContext="{Binding Downloads}" Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=Downloads}"/>
                    <views:LibraryPage DataContext="{Binding Library}" Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=Library}"/>
                    <views:SettingsPage DataContext="{Binding Settings}" Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=Settings}"/>
                    <views:RedistPage DataContext="{Binding Redist}" Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=Redist}"/>
                    <views:AboutPage DataContext="{Binding About}" Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVisible}, ConverterParameter=About}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
