<UserControl x:Class="AgApp.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Style="{StaticResource PageTransition}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="520" HorizontalAlignment="Left" Margin="28,24,28,28">

            <TextBlock Text="About" Style="{StaticResource PageTitle}" Margin="0,0,0,28"/>

            <!-- Hero card -->
            <Border CornerRadius="13" Margin="0,0,0,20" Padding="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#28ffffff" Offset="0"/>
                        <GradientStop Color="#06ffffff" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="28,24">
                    <StackPanel>
                        <!-- Icon -->
                        <TextBlock Text="◈" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7c5cff" Offset="0"/>
                                    <GradientStop Color="#22d3ee" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <TextBlock Text="{Binding AppName}" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#7c5cff" Offset="0"/>
                                    <GradientStop Color="#22d3ee" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding AppTagline}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock Text="{Binding AppDescription}" Foreground="{StaticResource TextBrush}"
                                   FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                   LineHeight="20" Margin="0,0,0,24"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource AccentButton}" Margin="0,0,10,0"
                                    Command="{Binding OpenGitHubCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="GitHub" IsHitTestVisible="False"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenLicenseCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="MIT License" IsHitTestVisible="False"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Credits card -->
            <Border CornerRadius="13" Margin="0,0,0,20" Padding="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#28ffffff" Offset="0"/>
                        <GradientStop Color="#06ffffff" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Built With" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="12.5" LineHeight="22" TextWrapping="Wrap">
                            <Run Text="• .NET 8 · WPF" FontWeight="SemiBold"/><LineBreak/>
                            <Run Text="• CommunityToolkit.Mvvm"/><LineBreak/>
                            <Run Text="• Microsoft.Web.WebView2"/><LineBreak/>
                            <Run Text="• SharpCompress · Hardcodet.NotifyIcon.Wpf"/><LineBreak/>
                            <Run Text="• DiscordRichPresence (lachee)"/><LineBreak/>
                            <Run Text="• RAWG.io API for game metadata"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Keyboard shortcuts card -->
            <Border CornerRadius="13" Padding="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#28ffffff" Offset="0"/>
                        <GradientStop Color="#06ffffff" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Keyboard Shortcuts" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Open Settings" FontSize="12.5"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Ctrl + ," FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Focus search (Library)" FontSize="12.5"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl + F" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Deselect game (Library)" FontSize="12.5"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Escape" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Minimize to tray" FontSize="12.5"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Win button (minimize)" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
