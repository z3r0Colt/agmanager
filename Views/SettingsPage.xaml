<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AgApp.ViewModels" x:Class="AgApp.Views.SettingsPage" Background="Transparent" Style="{StaticResource PageTransition}">
    <UserControl.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="32,30,32,24">
            <TextBlock Text="MAKE IT YOURS" Style="{StaticResource Caption}" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,8"/>
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="A setup that works for the way you play." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,0,32,16" MaxWidth="900" HorizontalAlignment="Stretch">
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Installation &amp; storage" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                        <TextBlock Text="Game installation folder" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="New downloads are saved and extracted here. Existing games and active downloads stay in their current folders." Style="{StaticResource SettingHint}" Margin="0,3,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DownloadFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingTextBox}" AutomationProperties.Name="Game installation folder"/>
                            <Button Grid.Column="1" Content="Choose folder" Command="{Binding BrowseFolderCommand}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/>
                        </Grid>
                        <CheckBox Content="Delete archives after extraction" IsChecked="{Binding DeleteZipAfterExtract}" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Downloads" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Connections per download" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Use fewer on slower connections." Style="{StaticResource SettingHint}"/>
                                <Slider Minimum="1" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ConnectionsPerDownload}" Margin="0,8,0,6" AutomationProperties.Name="Connections per download"/>
                                <TextBlock Text="{Binding ConnectionsPerDownload, StringFormat={}{0} connections}" Foreground="{StaticResource AccentLightBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Simultaneous downloads" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Control how many games download at once." Style="{StaticResource SettingHint}"/>
                                <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxConcurrentDownloads}" Margin="0,8,0,6" AutomationProperties.Name="Simultaneous downloads"/>
                                <TextBlock Text="{Binding MaxConcurrentDownloads, StringFormat={}{0} downloads}" Foreground="{StaticResource AccentLightBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Separator Margin="0,20"/>
                        <TextBlock Text="Bandwidth limit (KB/s)" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Set to 0 for unlimited bandwidth." Style="{StaticResource SettingHint}"/>
                        <TextBox Text="{Binding MaxBandwidthKbps, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingTextBox}" Width="160" HorizontalAlignment="Left" Margin="0,8,0,18" AutomationProperties.Name="Bandwidth limit"/>
                        <CheckBox Content="Notify me when a game is ready to play" IsChecked="{Binding NotifyOnExtractionComplete}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Save backups" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Keep a little insurance for your next adventure." Style="{StaticResource SettingHint}" Margin="0,0,0,18"/>
                        <TextBlock Text="Backup folder" Style="{StaticResource SettingLabel}"/>
                        <Grid Margin="0,8,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SaveBackupRoot, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingTextBox}" AutomationProperties.Name="Backup folder"/>
                            <Button Grid.Column="1" Content="Choose folder" Command="{Binding BrowseBackupFolderCommand}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Backups per game" Style="{StaticResource SettingLabel}"/>
                                <TextBox Text="{Binding MaxBackupsPerGame, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingTextBox}" Margin="0,8,0,0" AutomationProperties.Name="Backups per game"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Default schedule" Style="{StaticResource SettingLabel}"/>
                                <ComboBox ItemsSource="{x:Static local:SettingsViewModel.BackupScheduleOptions}" SelectedItem="{Binding DefaultBackupSchedule}" Margin="0,8,0,0" AutomationProperties.Name="Backup schedule"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="App preferences" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
                        <CheckBox Content="Minimize to the system tray" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,14"/>
                        <CheckBox Content="Keep running in the tray when I press Alt+F4" IsChecked="{Binding CloseToTray}" Margin="0,0,0,14"/>
                        <CheckBox Content="Launch when Windows starts" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,14"/>
                        <CheckBox Content="Show download notifications" IsChecked="{Binding ShowNotifications}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="Library data" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Export your library as a backup, or merge games from a previous export." Style="{StaticResource SettingHint}" Margin="0,0,0,16"/>
                        <WrapPanel>
                            <Button Content="Export library" Command="{Binding ExportLibraryAsyncCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                            <Button Content="Import library" Command="{Binding ImportLibraryAsyncCommand}" Style="{StaticResource SecondaryButton}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <Expander Header="Advanced &amp; integrations" Foreground="{StaticResource TextBrush}">
                        <StackPanel Margin="0,18,0,0">
                            <TextBlock Text="RAWG API key" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Used to fetch covers and game descriptions. Get a key at rawg.io/apidocs." Style="{StaticResource SettingHint}"/>
                            <TextBox Text="{Binding RawgApiKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingTextBox}" Margin="0,8,0,18"/>
                            <TextBlock Text="Update check interval (hours)" Style="{StaticResource SettingLabel}"/>
                            <TextBox Text="{Binding UpdateCheckIntervalHours, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingTextBox}" Width="160" HorizontalAlignment="Left" Margin="0,8,0,18"/>
                            <TextBlock Text="Discord Rich Presence" Style="{StaticResource SettingLabel}"/>
                            <TextBlock Text="Preview configuration. Discord status sharing is not available in this version." Style="{StaticResource SettingHint}"/>
                            <CheckBox Content="Enable when supported" IsChecked="{Binding EnableDiscordRichPresence}" Margin="0,8,0,12"/>
                            <TextBox Text="{Binding DiscordClientId, UpdateSourceTrigger=PropertyChanged}" Tag="Discord application client ID" Style="{StaticResource SettingTextBox}"/>
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Changes apply when you save." Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                <Setter Property="Visibility" Value="{Binding StatusMessage, Converter={StaticResource StringToVisible}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="#FF9AAB"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="Save settings" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
