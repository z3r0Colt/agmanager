<UserControl x:Class="AgApp.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AgApp.ViewModels"
             Background="Transparent"
             Style="{StaticResource PageTransition}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="580" HorizontalAlignment="Left" Margin="28,24,28,28">

            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,28"/>

            <!-- Download Folder card -->
            <Border CornerRadius="13" Margin="0,0,0,20" Padding="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#28ffffff" Offset="0"/>
                        <GradientStop Color="#06ffffff" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Download Folder" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Where downloaded games are saved and extracted"
                                   Style="{StaticResource SettingHint}"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource SettingTextBox}"
                                     Text="{Binding DownloadFolder, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="Browse" IsHitTestVisible="False"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Download Settings card -->
            <Border CornerRadius="13" Margin="0,0,0,20" Padding="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#28ffffff" Offset="0"/>
                        <GradientStop Color="#06ffffff" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Download Settings" Style="{StaticResource SectionHeader}" Margin="0,0,0,16"/>

                        <TextBlock Text="Connections per Download" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Higher = faster on good connections. Default: 8"
                                   Style="{StaticResource SettingHint}"/>
                        <Slider Minimum="1" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding ConnectionsPerDownload}" Margin="0,4,0,4"/>
                        <TextBlock FontSize="13" Margin="0,0,0,20">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#7c5cff" Offset="0"/>
                                    <GradientStop Color="#22d3ee" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <Run Text="{Binding ConnectionsPerDownload}"/>
                            <Run Text=" connections"/>
                        </TextBlock>

                        <TextBlock Text="Max Bandwidth (KB/s)" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="0 = unlimited" Style="{StaticResource SettingHint}"/>
                        <TextBox Style="{StaticResource SettingTextBox}"
                                 Text="{Binding MaxBandwidthKbps, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,20"/>

                        <TextBlock Text="Max Concurrent Downloads" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="How many downloads run simultaneously (1–5)" Style="{StaticResource SettingHint}"/>
                        <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding MaxConcurrentDownloads}" Margin="0,4,0,4"/>
                        <TextBlock FontSize="13" Margin="0,0,0,20">
                            <Run Text="{Binding MaxConcurrentDownloads}"/>
                            <Run Text=" concurrent"/>
                        </TextBlock>

                        <CheckBox Content="Notify when extraction completes"
                                  IsChecked="{Binding NotifyOnExtractionComplete}"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- API Key card -->
            <Border CornerRadius="13" Margin="0,0,0,20" Padding="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#28ffffff" Offset="0"/>
                        <GradientStop Color="#06ffffff" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="RAWG.io API Key" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Style="{StaticResource SettingHint}">
                            <Run Text="Free at rawg.io/apidocs — used to auto-fetch game covers and descriptions"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource SettingTextBox}"
                                 Text="{Binding RawgApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,6,0,0" Tag="Paste your API key here…"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Save Backup Settings card -->
            <Border CornerRadius="13" Margin="0,0,0,20" Padding="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#28ffffff" Offset="0"/>
                        <GradientStop Color="#06ffffff" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Save Game Backups" Style="{StaticResource SectionHeader}" Margin="0,0,0,16"/>
                        <TextBlock Text="Backup Folder" Style="{StaticResource SettingLabel}"/>
                        <TextBox Style="{StaticResource SettingTextBox}" Margin="0,4,0,10"
                                 Text="{Binding SaveBackupRoot, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Max Backups per Game" Style="{StaticResource SettingLabel}"/>
                        <TextBox Style="{StaticResource SettingTextBox}" Margin="0,4,0,10"
                                 Text="{Binding MaxBackupsPerGame, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Default Backup Schedule" Style="{StaticResource SettingLabel}"/>
                        <ComboBox Margin="0,4,0,0" SelectedValue="{Binding DefaultBackupSchedule}"
                                  ItemsSource="{x:Static local:SettingsViewModel.BackupScheduleOptions}"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Discord Rich Presence card -->
            <Border CornerRadius="13" Margin="0,0,0,20" Padding="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#28ffffff" Offset="0"/>
                        <GradientStop Color="#06ffffff" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Discord Rich Presence" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource SettingHint}" Margin="0,0,0,12">
                            <Run Text="Shows the game you are playing in your Discord status. Requires a Discord Application Client ID from"/>
                            <Run Text=" discord.com/developers/applications" FontStyle="Italic"/>
                            <Run Text="."/>
                        </TextBlock>
                        <CheckBox Content="Enable Discord Rich Presence (stub — configure Client ID below)"
                                  IsChecked="{Binding EnableDiscordRichPresence}" Margin="0,0,0,10"/>
                        <TextBlock Text="Discord Application Client ID" Style="{StaticResource SettingLabel}"/>
                        <TextBox Style="{StaticResource SettingTextBox}" Margin="0,4,0,0"
                                 Text="{Binding DiscordClientId, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="e.g. 1234567890123456789"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Behaviour card -->
            <Border CornerRadius="13" Margin="0,0,0,28" Padding="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#28ffffff" Offset="0"/>
                        <GradientStop Color="#06ffffff" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Behaviour" Style="{StaticResource SectionHeader}" Margin="0,0,0,16"/>
                        <CheckBox Content="Delete zip files after extraction" Margin="0,0,0,10"
                                  IsChecked="{Binding DeleteZipAfterExtract}"/>
                        <CheckBox Content="Minimize to system tray when minimized" Margin="0,0,0,10"
                                  IsChecked="{Binding MinimizeToTray}"/>
                        <CheckBox Content="Close to tray instead of quitting (Alt+F4 / OS close button)"
                                  Margin="0,0,0,10" IsChecked="{Binding CloseToTray}"/>
                        <CheckBox Content="Start with Windows (adds to startup registry)" Margin="0,0,0,10"
                                  IsChecked="{Binding StartWithWindows}"/>
                        <CheckBox Content="Show notifications when downloads finish"
                                  IsChecked="{Binding ShowNotifications}"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Library Export / Import card -->
            <Border CornerRadius="13" Margin="0,0,0,28" Padding="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#28ffffff" Offset="0"/>
                        <GradientStop Color="#06ffffff" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Library Data" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource SettingHint}" Margin="0,0,0,14">
                            <Run Text="Export your library to a JSON file or import from a previously exported file."/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                    Command="{Binding ExportLibraryAsyncCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="Export Library" IsHitTestVisible="False"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ImportLibraryAsyncCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                                    <TextBlock Text="Import Library" IsHitTestVisible="False"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <Button Content="Save Settings" Style="{StaticResource AccentButton}"
                    Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
