<UserControl x:Class="AgApp.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AgApp.Models"
             xmlns:vm="clr-namespace:AgApp.ViewModels"
             Background="Transparent"
             Style="{StaticResource PageTransition}">

    <Grid>
        <!-- ══════════════════════════════════════════════════════════════
             PANEL 1 — Card grid
             ══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding ShowDetail, Converter={StaticResource BoolToCollapsed}}"
              Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Library" Style="{StaticResource PageTitle}"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Style="{StaticResource SearchBox}" Margin="20,0,0,0"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Filter games…" MaxWidth="300" HorizontalAlignment="Left"/>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding BackupAllAsyncCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Back Up All" IsHitTestVisible="False"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="3" Text="Sort:" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="4" ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SortBy}" VerticalAlignment="Center" Width="140"/>
            </Grid>

            <!-- Empty state -->
            <ContentControl Grid.Row="1" Style="{StaticResource EmptyState}"
                            Tag="&#xE8F1;"
                            Content="No games installed yet. Browse and download games to see them here."
                            Visibility="{Binding Games.Count, Converter={StaticResource ZeroToVisible}}"/>

            <!-- Game grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:InstalledGame}">
                            <!-- Card: outer Grid owns the scale; glow sits behind content
                                 so the DropShadowEffect never touches the content layer. -->
                            <Grid Width="186" Margin="0,0,16,16"
                                  RenderTransformOrigin="0.5,0.5" Cursor="Hand">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="cardScale"/>
                                </Grid.RenderTransform>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="UIElement.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="cardScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1.03" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="cardScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1.03" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="playOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="cardScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="1.0" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="cardScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="1.0" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="playOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>

                                <!-- Glow layer: effect applied here, not on the content -->
                                <Border CornerRadius="12" IsHitTestVisible="False"
                                        Background="{StaticResource CardBrush}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Value="True"
                                                    Binding="{Binding IsMouseOver,
                                                              RelativeSource={RelativeSource AncestorType=Grid}}">
                                                    <Setter Property="BorderBrush" Value="#4d7c5cff"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#7c5cff" ShadowDepth="0"
                                                                              BlurRadius="24" Opacity="0.45"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Content layer: no Effect — stays pixel-crisp -->
                                <Border CornerRadius="11" ClipToBounds="True"
                                        Background="{StaticResource CardBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="220"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Cover area -->
                                        <Grid Grid.Row="0">
                                            <!-- Cover image -->
                                            <Border Background="#1a1f38">
                                                <Image Source="{Binding CoverUrl, Mode=OneWay}" Stretch="UniformToFill"/>
                                            </Border>
                                            <!-- Placeholder -->
                                            <TextBlock Text="&#xE7FC;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="52" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                                       Foreground="#30405580">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CoverUrl, Mode=OneWay}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Gradient overlay at bottom -->
                                            <Border VerticalAlignment="Bottom" Height="90"
                                                    Background="{StaticResource CardOverlayBrush}"
                                                    IsHitTestVisible="False"/>
                                            <!-- Metacritic badge -->
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    Margin="8,0,0,8" CornerRadius="6" Padding="6,3"
                                                    Background="{Binding MetacriticScore, Converter={StaticResource MetacriticToBrush}}"
                                                    Visibility="{Binding MetacriticScore, Converter={StaticResource IntGtZeroToVisible}}">
                                                <TextBlock Text="{Binding MetacriticScore, Mode=OneWay}"
                                                           Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <!-- Favorite button -->
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,6,6,0" Style="{StaticResource TransparentButton}"
                                                    Padding="4"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Toggle favorite">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE006;"/>
                                                            <Setter Property="Foreground" Value="#88aabb"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite, Mode=OneWay}" Value="True">
                                                                    <Setter Property="Text" Value="&#xEB52;"/>
                                                                    <Setter Property="Foreground" Value="#f43f8e"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <!-- Play overlay (fades in on hover) -->
                                            <Grid x:Name="playOverlay" Opacity="0" Background="#66000015">
                                                <Button Style="{StaticResource TransparentButton}"
                                                        Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Border Width="52" Height="52" CornerRadius="26"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#cc7c5cff" Offset="0"/>
                                                                <GradientStop Color="#cc22d3ee" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <TextBlock Text="&#xE102;"
                                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="22" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsHitTestVisible="False"/>
                                                    </Border>
                                                </Button>
                                            </Grid>
                                            <!-- Full card click for detail -->
                                            <Button Style="{StaticResource TransparentButton}"
                                                    Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="View details"/>
                                        </Grid>

                                        <!-- Info strip -->
                                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="10,9">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title, Mode=OneWay}" Foreground="White"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" MaxHeight="34"/>
                                                <Border CornerRadius="12" Padding="7,2" Margin="0,4,0,4"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding Genre, Converter={StaticResource StringToVisible}}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#2a7c5cff" Offset="0"/>
                                                            <GradientStop Color="#2a22d3ee" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding Genre, Mode=OneWay}"
                                                               Foreground="{StaticResource AccentLightBrush}" FontSize="9"/>
                                                </Border>
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,0,2">
                                                    <Run Text="{Binding InstalledSizeDisplay, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding InstalledAtDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource MiniAccentButton}"
                                                            Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE102;"
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       FontSize="11" Margin="0,0,4,0" IsHitTestVisible="False"/>
                                                            <TextBlock Text="Play" IsHitTestVisible="False"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1" Style="{StaticResource MiniIconButton}" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Open folder">
                                                        <TextBlock Text="&#xE838;"
                                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="12" IsHitTestVisible="False"/>
                                                    </Button>
                                                    <Button Grid.Column="2" Style="{StaticResource MiniIconButton}" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.DeleteGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Delete game">
                                                        <TextBlock Text="&#xE74D;"
                                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="12" IsHitTestVisible="False"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             PANEL 2 — Detail / Edit / Metadata search
             ══════════════════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVisible}}"
              Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BackToLibraryCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Library" IsHitTestVisible="False"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding SelectedGame.Title, Mode=OneWay}"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToCollapsed}}">
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding FetchMetadataCommand}"
                            IsEnabled="{Binding FetchingMetadata, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                            <TextBlock IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Fetch Metadata"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FetchingMetadata}" Value="True">
                                                <Setter Property="Text" Value="Fetching…"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding OpenMetadataSearchCommand}"
                            Visibility="{Binding ShowMetadataSearch, Converter={StaticResource BoolToCollapsed}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Search Metadata" IsHitTestVisible="False"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButton}"
                            Command="{Binding StartEditCommand}"
                            Visibility="{Binding ShowMetadataSearch, Converter={StaticResource BoolToCollapsed}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Edit Info" IsHitTestVisible="False"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding CloseMetadataSearchCommand}"
                            Visibility="{Binding ShowMetadataSearch, Converter={StaticResource BoolToVisible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Close Search" IsHitTestVisible="False"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}">
                    <Button Style="{StaticResource AccentButton}"
                            Command="{Binding SaveEditCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Save" IsHitTestVisible="False"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelEditCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Cancel" IsHitTestVisible="False"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!-- ── DETAIL VIEW ─────────────────────────────────── -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsEditing, Converter={StaticResource BoolToCollapsed}}">
                    <StackPanel>
                        <!-- Hero -->
                        <Border Height="280" CornerRadius="12" ClipToBounds="True"
                                Background="{StaticResource CardBrush}" Margin="0,0,0,20">
                            <Grid>
                                <Image Source="{Binding SelectedGame.HeroOrCoverUrl, Mode=OneWay}"
                                       Stretch="UniformToFill" Opacity="0.5"/>
                                <Border Background="{StaticResource HeroBannerOverlay}"/>
                                <TextBlock Text="&#xE7FC;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="100" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Opacity="0.15" IsHitTestVisible="False"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedGame.HeroOrCoverUrl, Mode=OneWay}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Grid VerticalAlignment="Bottom" Margin="20,0,20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="85" Height="115" CornerRadius="8"
                                            ClipToBounds="True" Background="#1a1a2a" Margin="0,0,16,0">
                                        <Image Source="{Binding SelectedGame.CoverUrl, Mode=OneWay}" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding SelectedGame.Title, Mode=OneWay}"
                                                   Foreground="White" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border CornerRadius="12" Padding="10,4" Margin="0,0,8,0"
                                                    Visibility="{Binding SelectedGame.Genre, Converter={StaticResource StringToVisible}}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#2a7c5cff" Offset="0"/>
                                                        <GradientStop Color="#2a22d3ee" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="{Binding SelectedGame.Genre, Mode=OneWay}"
                                                           Foreground="{StaticResource AccentLightBrush}" FontSize="12"/>
                                            </Border>
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding SelectedGame.ReleaseYear, Converter={StaticResource IntGtZeroToVisible}}">
                                                <Run Text="{Binding SelectedGame.ReleaseYear, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource TransparentButton}"
                                            Padding="8" VerticalAlignment="Bottom"
                                            Command="{Binding ToggleFavoriteCommand}"
                                            CommandParameter="{Binding SelectedGame}"
                                            ToolTip="Toggle favorite">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE006;"/>
                                                    <Setter Property="Foreground" Value="#88aabb"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGame.IsFavorite, Mode=OneWay}" Value="True">
                                                            <Setter Property="Text" Value="&#xEB52;"/>
                                                            <Setter Property="Foreground" Value="#f43f8e"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Badges -->
                        <WrapPanel Margin="0,0,0,16">
                            <Border CornerRadius="8" Padding="12,8" Margin="0,0,8,8"
                                    Background="{Binding SelectedGame.MetacriticScore, Converter={StaticResource MetacriticToBrush}}"
                                    Visibility="{Binding SelectedGame.MetacriticScore, Converter={StaticResource IntGtZeroToVisible}}">
                                <StackPanel>
                                    <TextBlock Text="METACRITIC" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedGame.MetacriticScore, Mode=OneWay}"
                                               Foreground="White" FontSize="22" FontWeight="Bold" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="8" Padding="12,8" Margin="0,0,8,8"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Visibility="{Binding SelectedGame.EsrbRating, Converter={StaticResource StringToVisible}}">
                                <StackPanel>
                                    <TextBlock Text="ESRB" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedGame.EsrbRating, Mode=OneWay}"
                                               Foreground="White" FontSize="16" FontWeight="Bold" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="8" Padding="12,8" Margin="0,0,8,8"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Visibility="{Binding SelectedGame.PlayerSupport, Converter={StaticResource StringToVisible}}">
                                <StackPanel>
                                    <TextBlock Text="PLAYERS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedGame.PlayerSupport, Mode=OneWay}"
                                               Foreground="White" FontSize="12" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="8" Padding="12,8" Margin="0,0,8,8"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Visibility="{Binding SelectedGame.ControllerSupport, Converter={StaticResource StringToVisible}}">
                                <StackPanel>
                                    <TextBlock Text="CONTROLLER" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedGame.ControllerSupport, Mode=OneWay}"
                                               Foreground="White" FontSize="12" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- Tags -->
                        <ItemsControl ItemsSource="{Binding SelectedGame.Tags}" Margin="0,0,0,20"
                                      Visibility="{Binding SelectedGame.Tags.Count, Converter={StaticResource IntGtZeroToVisible}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="20" Padding="12,5" Margin="0,0,6,6"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#157c5cff" Offset="0"/>
                                                <GradientStop Color="#0f22d3ee" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Mode=OneWay}"
                                                   Foreground="{StaticResource AccentLightBrush}" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Main body: left + right -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="230"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: actions + screenshots + description + notes + rating -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <!-- Action buttons -->
                                <WrapPanel Margin="0,0,0,24">
                                    <Button Style="{StaticResource AccentButton}"
                                            Padding="22,11" FontSize="15" Margin="0,0,8,8"
                                            Command="{Binding LaunchGameCommand}"
                                            CommandParameter="{Binding SelectedGame}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE102;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="15" Margin="0,0,8,0" IsHitTestVisible="False"/>
                                            <TextBlock Text="Play" IsHitTestVisible="False"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                            Command="{Binding OpenFolderCommand}"
                                            CommandParameter="{Binding SelectedGame}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                                            <TextBlock Text="Folder" IsHitTestVisible="False"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                            Command="{Binding OpenWebsiteCommand}"
                                            CommandParameter="{Binding SelectedGame}"
                                            Visibility="{Binding SelectedGame.Website, Converter={StaticResource StringToVisible}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE12B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                                            <TextBlock Text="Website" IsHitTestVisible="False"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Foreground="#f43f8e" Margin="0,0,0,8"
                                            Command="{Binding DeleteGameCommand}"
                                            CommandParameter="{Binding SelectedGame}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"/>
                                            <TextBlock Text="Delete" IsHitTestVisible="False"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <!-- Launch Options Expander -->
                                <Expander Header="Launch Options" Margin="0,0,0,16" Foreground="{StaticResource TextBrush}">
                                    <StackPanel Margin="0,10,0,0">
                                        <!-- Launch target -->
                                        <TextBlock Text="Launch Target" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Leave blank to use auto-detected launcher (Run Me!.bat or largest exe)"
                                                   Style="{StaticResource SettingHint}"/>
                                        <Grid Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource SettingTextBox}"
                                                     Text="{Binding SelectedGame.LaunchTargetOverride, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="Auto-detected"/>
                                            <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding BrowseLaunchTargetCommand}"
                                                    CommandParameter="{Binding SelectedGame}">
                                                <TextBlock Text="Browse" IsHitTestVisible="False"/>
                                            </Button>
                                        </Grid>
                                        <!-- Suggested exe from bat -->
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,10"
                                                   Visibility="{Binding SuggestedExe, Converter={StaticResource StringToVisible}}">
                                            <Run Text="Suggested exe from bat: "/>
                                            <Run Text="{Binding SuggestedExe}"/>
                                        </TextBlock>
                                        <!-- Run as admin -->
                                        <CheckBox Content="Run as administrator" Margin="0,0,0,10"
                                                  IsChecked="{Binding SelectedGame.RunAsAdmin}"/>
                                        <!-- Working directory -->
                                        <TextBlock Text="Working Directory Override" Style="{StaticResource SettingLabel}"/>
                                        <Grid Margin="0,4,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource SettingTextBox}"
                                                     Text="{Binding SelectedGame.WorkingDirectoryOverride, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="Default (bat's folder)"/>
                                            <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding BrowseWorkingDirCommand}"
                                                    CommandParameter="{Binding SelectedGame}">
                                                <TextBlock Text="Browse" IsHitTestVisible="False"/>
                                            </Button>
                                        </Grid>
                                        <!-- Pre-launch -->
                                        <TextBlock Text="Pre-Launch Program" Style="{StaticResource SettingLabel}"/>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource SettingTextBox}"
                                                     Text="{Binding SelectedGame.PreLaunchPath, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="Optional program to run before game"/>
                                            <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding BrowsePreLaunchCommand}"
                                                    CommandParameter="{Binding SelectedGame}">
                                                <TextBlock Text="Browse" IsHitTestVisible="False"/>
                                            </Button>
                                        </Grid>
                                        <TextBox Style="{StaticResource SettingTextBox}" Margin="0,0,0,10"
                                                 Text="{Binding SelectedGame.PreLaunchArgs, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Pre-launch arguments (optional)"/>
                                        <!-- Save button -->
                                        <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                                Command="{Binding SaveLaunchOptionsCommand}"
                                                CommandParameter="{Binding SelectedGame}">
                                            <TextBlock Text="Save Launch Options" IsHitTestVisible="False"/>
                                        </Button>
                                    </StackPanel>
                                </Expander>

                                <!-- Save Game Backup Expander -->
                                <Expander Header="Save Game Backup" Margin="0,0,0,16" Foreground="{StaticResource TextBrush}">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="Save Folder" Style="{StaticResource SettingLabel}"/>
                                        <Grid Margin="0,4,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource SettingTextBox}"
                                                     Text="{Binding SelectedGame.SaveFolder, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="Path to save game folder"/>
                                            <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding BrowseSaveFolderCommand}"
                                                    CommandParameter="{Binding SelectedGame}">
                                                <TextBlock Text="Browse" IsHitTestVisible="False"/>
                                            </Button>
                                            <Button Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DetectSaveFolderCommand}"
                                                    CommandParameter="{Binding SelectedGame}">
                                                <TextBlock Text="Detect" IsHitTestVisible="False"/>
                                            </Button>
                                        </Grid>
                                        <!-- Candidates list -->
                                        <ItemsControl ItemsSource="{Binding SaveCandidates}"
                                                      Visibility="{Binding SaveCandidates.Count, Converter={StaticResource IntGtZeroToVisible}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,2" Style="{StaticResource TransparentButton}"
                                                            Command="{Binding DataContext.SelectSaveCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="{Binding}" Foreground="{StaticResource AccentLightBrush}" FontSize="11"
                                                                   TextWrapping="Wrap"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Backup Schedule" Style="{StaticResource SettingLabel}" Margin="0,8,0,0"/>
                                        <ComboBox Margin="0,4,0,8"
                                                  SelectedValue="{Binding SelectedGame.BackupSchedule}"
                                                  ItemsSource="{x:Static vm:LibraryViewModel.BackupScheduleOptions}"/>
                                        <Button Style="{StaticResource MiniAccentButton}" HorizontalAlignment="Left" Margin="0,0,0,8"
                                                Command="{Binding BackupNowAsyncCommand}"
                                                CommandParameter="{Binding SelectedGame}">
                                            <TextBlock Text="Backup Now" IsHitTestVisible="False"/>
                                        </Button>
                                    </StackPanel>
                                </Expander>

                                <!-- Screenshots -->
                                <StackPanel Margin="0,0,0,24"
                                            Visibility="{Binding SelectedGame.Screenshots.Count, Converter={StaticResource IntGtZeroToVisible}}">
                                    <TextBlock Text="SCREENSHOTS" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding SelectedGame.Screenshots}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource TransparentButton}" Margin="0,0,10,0"
                                                            Command="{Binding DataContext.OpenScreenshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Click to enlarge">
                                                        <Border Width="250" Height="145" CornerRadius="8"
                                                                ClipToBounds="True" Background="{StaticResource CardBrush}">
                                                            <Image Source="{Binding Mode=OneWay}" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Description -->
                                <TextBlock Text="ABOUT" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"
                                           Visibility="{Binding SelectedGame.Description, Converter={StaticResource StringToVisible}}"/>
                                <TextBlock Text="{Binding SelectedGame.Description, Mode=OneWay}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13" TextWrapping="Wrap" LineHeight="22"
                                           Margin="0,0,0,24"
                                           Visibility="{Binding SelectedGame.Description, Converter={StaticResource StringToVisible}}"/>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,24"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Visibility="{Binding SelectedGame.Description, Converter={StaticResource BoolToCollapsed}}">
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap">
                                        <Run Text="No description yet. Click "/>
                                        <Run Text="Fetch Metadata" Foreground="{StaticResource AccentBrush}"/>
                                        <Run Text=" above to auto-fill from RAWG.io, or "/>
                                        <Run Text="Search Metadata" Foreground="{StaticResource AccentBrush}"/>
                                        <Run Text=" if the title wasn't found automatically."/>
                                    </TextBlock>
                                </Border>

                                <!-- Notes -->
                                <StackPanel Visibility="{Binding SelectedGame.PersonalNotes, Converter={StaticResource StringToVisible}}"
                                            Margin="0,0,0,24">
                                    <TextBlock Text="MY NOTES" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding SelectedGame.PersonalNotes, Mode=OneWay}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="13" TextWrapping="Wrap" LineHeight="22"/>
                                    </Border>
                                </StackPanel>

                                <!-- Rating -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="MY RATING" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource TransparentButton}" Padding="2"
                                                Command="{Binding SetUserRatingCommand}" CommandParameter="1" ToolTip="1 star">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE734;"/>
                                                        <Setter Property="Foreground" Value="#444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.Star1, Mode=OneWay}" Value="True">
                                                                <Setter Property="Text" Value="&#xE735;"/>
                                                                <Setter Property="Foreground" Value="#fbbf24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource TransparentButton}" Padding="2"
                                                Command="{Binding SetUserRatingCommand}" CommandParameter="2" ToolTip="2 stars">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE734;"/>
                                                        <Setter Property="Foreground" Value="#444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.Star2, Mode=OneWay}" Value="True">
                                                                <Setter Property="Text" Value="&#xE735;"/>
                                                                <Setter Property="Foreground" Value="#fbbf24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource TransparentButton}" Padding="2"
                                                Command="{Binding SetUserRatingCommand}" CommandParameter="3" ToolTip="3 stars">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE734;"/>
                                                        <Setter Property="Foreground" Value="#444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.Star3, Mode=OneWay}" Value="True">
                                                                <Setter Property="Text" Value="&#xE735;"/>
                                                                <Setter Property="Foreground" Value="#fbbf24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource TransparentButton}" Padding="2"
                                                Command="{Binding SetUserRatingCommand}" CommandParameter="4" ToolTip="4 stars">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE734;"/>
                                                        <Setter Property="Foreground" Value="#444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.Star4, Mode=OneWay}" Value="True">
                                                                <Setter Property="Text" Value="&#xE735;"/>
                                                                <Setter Property="Foreground" Value="#fbbf24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource TransparentButton}" Padding="2"
                                                Command="{Binding SetUserRatingCommand}" CommandParameter="5" ToolTip="5 stars">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE734;"/>
                                                        <Setter Property="Foreground" Value="#444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.Star5, Mode=OneWay}" Value="True">
                                                                <Setter Property="Text" Value="&#xE735;"/>
                                                                <Setter Property="Foreground" Value="#fbbf24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <TextBlock Text="(click same star to clear)" VerticalAlignment="Center"
                                                   Foreground="#444" FontSize="11" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right sidebar -->
                            <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="12"
                                    Padding="18" VerticalAlignment="Top"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="GAME INFO" Style="{StaticResource SectionHeader}" Margin="0,0,0,16"/>
                                    <StackPanel Visibility="{Binding SelectedGame.Developer, Converter={StaticResource StringToVisible}}" Margin="0,0,0,12">
                                        <TextBlock Text="DEVELOPER" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding SelectedGame.Developer, Mode=OneWay}" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding SelectedGame.Publisher, Converter={StaticResource StringToVisible}}" Margin="0,0,0,12">
                                        <TextBlock Text="PUBLISHER" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding SelectedGame.Publisher, Mode=OneWay}" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Separator Margin="0,0,0,12"
                                               Visibility="{Binding SelectedGame.Developer, Converter={StaticResource StringToVisible}}"/>
                                    <StackPanel Margin="0,0,0,12"
                                                Visibility="{Binding SelectedGame.InstalledSizeBytes, Converter={StaticResource IntGtZeroToVisible}}">
                                        <TextBlock Text="SIZE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding SelectedGame.InstalledSizeDisplay, Mode=OneWay}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="INSTALLED" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding SelectedGame.InstalledAtDisplay, Mode=OneWay}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="PLAYTIME" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding SelectedGame.PlayTimeDisplay, Mode=OneWay}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="LAST PLAYED" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding SelectedGame.LastPlayedDisplay, Mode=OneWay}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Separator Margin="0,0,0,12"/>
                                    <StackPanel Margin="0,0,0,12"
                                                Visibility="{Binding SelectedGame.Version, Converter={StaticResource StringToVisible}}">
                                        <TextBlock Text="VERSION" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding SelectedGame.Version, Mode=OneWay}" Foreground="White" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="INSTALL PATH" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                        <TextBlock Text="{Binding SelectedGame.InstallPath, Mode=OneWay}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── EDIT FORM ────────────────────────────────────── -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Title" Style="{StaticResource SettingLabel}"/>
                                <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding SelectedGame.Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16"/>
                                <TextBlock Text="Genre" Style="{StaticResource SettingLabel}"/>
                                <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding SelectedGame.Genre, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Action, RPG" Margin="0,4,0,16"/>
                                <TextBlock Text="Developer" Style="{StaticResource SettingLabel}"/>
                                <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding SelectedGame.Developer, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16"/>
                                <TextBlock Text="Publisher" Style="{StaticResource SettingLabel}"/>
                                <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding SelectedGame.Publisher, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Release Year" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding SelectedGame.ReleaseYear, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Tag="e.g. 2023"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Version" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding SelectedGame.Version, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Tag="e.g. 1.0.3"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ESRB Rating" Style="{StaticResource SettingLabel}"/>
                                        <ComboBox ItemsSource="{Binding EsrbOptions}" SelectedItem="{Binding SelectedGame.EsrbRating}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Controller Support" Style="{StaticResource SettingLabel}"/>
                                        <ComboBox ItemsSource="{Binding ControllerOptions}" SelectedItem="{Binding SelectedGame.ControllerSupport}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Metacritic Score" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding SelectedGame.MetacriticScore, UpdateSourceTrigger=PropertyChanged}" Tag="0–100" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Player Support" Style="{StaticResource SettingLabel}"/>
                                        <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding SelectedGame.PlayerSupport, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Single-player" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Website" Style="{StaticResource SettingLabel}"/>
                                <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding SelectedGame.Website, UpdateSourceTrigger=PropertyChanged}" Tag="https://..." Margin="0,4,0,16"/>
                                <TextBlock Text="Launch Arguments" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Optional arguments passed to the exe on launch" Style="{StaticResource SettingHint}"/>
                                <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding SelectedGame.LaunchArguments, UpdateSourceTrigger=PropertyChanged}" Tag="-windowed -dx11" Margin="0,4,0,16"/>
                                <TextBlock Text="Tags" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Comma-separated list of tags" Style="{StaticResource SettingHint}"/>
                                <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding EditTagsText, UpdateSourceTrigger=PropertyChanged}" Tag="Action, Open World, Roguelike…" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cover Image" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Paste a URL or browse for a local image" Style="{StaticResource SettingHint}"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding SelectedGame.CoverUrl, UpdateSourceTrigger=PropertyChanged}" Tag="https://…"/>
                                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding BrowseCoverImageCommand}"/>
                                </Grid>
                                <Border Height="130" CornerRadius="8" ClipToBounds="True" Background="{StaticResource CardBrush}" Margin="0,8,0,20">
                                    <Image Source="{Binding SelectedGame.CoverUrl, Mode=OneWay}" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="Hero / Banner Image" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Wide image shown as the detail page banner (16:9 recommended)" Style="{StaticResource SettingHint}"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding SelectedGame.HeroUrl, UpdateSourceTrigger=PropertyChanged}" Tag="https://…"/>
                                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding BrowseHeroImageCommand}"/>
                                </Grid>
                                <Border Height="130" CornerRadius="8" ClipToBounds="True" Background="{StaticResource CardBrush}" Margin="0,8,0,20">
                                    <Image Source="{Binding SelectedGame.HeroOrCoverUrl, Mode=OneWay}" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="Description" Style="{StaticResource SettingLabel}"/>
                                <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding SelectedGame.Description, UpdateSourceTrigger=PropertyChanged}" Height="180" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,4,0,20"/>
                                <TextBlock Text="My Notes" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Text="Personal notes visible in the game detail view" Style="{StaticResource SettingHint}"/>
                                <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding SelectedGame.PersonalNotes, UpdateSourceTrigger=PropertyChanged}" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Screenshots" Style="{StaticResource SettingLabel}" Margin="0,0,0,4"/>
                        <TextBlock Text="One image URL per row — shown as a scrollable strip on the detail page" Style="{StaticResource SettingHint}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding EditScreenshots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ScreenshotEntry}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource SettingTextBox}" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Tag="https://…"/>
                                        <Button Grid.Column="1" Style="{StaticResource MiniIconButton}" Margin="8,0,0,0" ToolTip="Remove"
                                                Command="{Binding DataContext.RemoveScreenshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" IsHitTestVisible="False"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Add Screenshot" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,6,0,32"
                                Command="{Binding AddScreenshotCommand}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── METADATA SEARCH ──────────────────────────────── -->
                <Border Panel.ZIndex="10" Background="{StaticResource BackgroundBrush}"
                        Visibility="{Binding ShowMetadataSearch, Converter={StaticResource BoolToVisible}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}"
                                     Text="{Binding MetadataSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Search RAWG.io for metadata…"/>
                            <Button Grid.Column="1" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                                    Command="{Binding RunMetadataSearchCommand}"
                                    IsEnabled="{Binding IsSearchingMetadata, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" Margin="0,0,6,0" IsHitTestVisible="False"
                                               Visibility="{Binding IsSearchingMetadata, Converter={StaticResource BoolToCollapsed}}"/>
                                    <TextBlock IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Search"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSearchingMetadata}" Value="True">
                                                        <Setter Property="Text" Value="Searching…"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding CloseMetadataSearchCommand}">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" IsHitTestVisible="False"/>
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,12"
                                           Visibility="{Binding MetadataSearchResults.Count, Converter={StaticResource ZeroToVisible}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Enter a title and click Search."/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSearchingMetadata}" Value="False">
                                                    <Setter Property="Text" Value="No results found. Try a different title."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding MetadataSearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:MetadataSearchResult}">
                                            <Border Background="{StaticResource CardBrush}" CornerRadius="10" Margin="0,0,0,8" Cursor="Hand"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#1e2a45"/>
                                                                <Setter Property="BorderBrush" Value="#2e3a5a"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Button Style="{StaticResource TransparentButton}"
                                                        Command="{Binding DataContext.ApplySearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Height="54" CornerRadius="10,0,0,10"
                                                                ClipToBounds="True" Background="#111">
                                                            <Image Source="{Binding ThumbnailUrl, Mode=OneWay}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,10">
                                                            <TextBlock Text="{Binding Title, Mode=OneWay}"
                                                                       Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0">
                                                                <Run Text="{Binding Released, Mode=OneWay}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding Genres, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="Apply →"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   FontSize="13" VerticalAlignment="Center" Margin="14,0"/>
                                                    </Grid>
                                                </Button>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Screenshot lightbox ─────────────────────────────────── -->
        <Grid Panel.ZIndex="100"
              Visibility="{Binding ShowScreenshotViewer, Converter={StaticResource BoolToVisible}}">
            <Grid.Background>
                <SolidColorBrush Color="Black" Opacity="0.88"/>
            </Grid.Background>
            <Button Style="{StaticResource TransparentButton}" Command="{Binding CloseScreenshotViewerCommand}"/>
            <Border MaxWidth="1100" MaxHeight="700" CornerRadius="12" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding ViewerImageUrl, Mode=OneWay}" Stretch="Uniform"/>
            </Border>
            <Button Style="{StaticResource IconButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                    Command="{Binding CloseScreenshotViewerCommand}" ToolTip="Close">
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16" IsHitTestVisible="False"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
