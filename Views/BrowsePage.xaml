<UserControl x:Class="AgApp.Views.BrowsePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="Transparent"
             Style="{StaticResource PageTransition}">

    <Grid Margin="12,10,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Glass toolbar ───────────────────────────────── -->
        <Border Grid.Row="0" CornerRadius="10" Padding="6,0">
            <Border.Background>
                <SolidColorBrush Color="#0e1220" Opacity="0.85"/>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#40ffffff" Offset="0"/>
                    <GradientStop Color="#0cffffff" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Back -->
                <Button Grid.Column="0" Style="{StaticResource IconButton}"
                        Width="36" Height="36" ToolTip="Back"
                        Click="Back_Click"
                        IsEnabled="{Binding CanGoBack}">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14" IsHitTestVisible="False"/>
                </Button>

                <!-- Forward -->
                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                        Width="36" Height="36" ToolTip="Forward" Margin="2,0,0,0"
                        Click="Forward_Click"
                        IsEnabled="{Binding CanGoForward}">
                    <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14" IsHitTestVisible="False"/>
                </Button>

                <!-- Refresh — spins while loading -->
                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                        Width="36" Height="36" ToolTip="Refresh" Margin="2,0,8,0"
                        Click="Refresh_Click">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14" IsHitTestVisible="False"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinSB">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0" To="360" Duration="0:0:0.7"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinSB"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- Loading bar (center of toolbar) -->
                <ProgressBar Grid.Column="3" Height="2" VerticalAlignment="Bottom"
                             IsIndeterminate="True" Background="Transparent" BorderThickness="0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}"/>
            </Grid>
        </Border>

        <!-- ── WebView2 glass frame ─────────────────────────── -->
        <!-- Outer: renders the visible glass border + glow (not over WebView2) -->
        <Border Grid.Row="2" CornerRadius="12" Padding="8">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#35ffffff" Offset="0"/>
                    <GradientStop Color="#08ffffff" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>1.5</Border.BorderThickness>
            <Border.Background>
                <SolidColorBrush Color="#0a0d14" Opacity="0.4"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#7c5cff" ShadowDepth="0" BlurRadius="18" Opacity="0.3"/>
            </Border.Effect>

            <!-- Inner: clips WebView2 to rounded corners -->
            <Border CornerRadius="6" ClipToBounds="True">
                <wv2:WebView2 x:Name="Browser"/>
            </Border>
        </Border>
    </Grid>
</UserControl>
